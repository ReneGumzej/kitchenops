# KitchenOps - Vorlage für Umgebungsvariablen
# Diese Datei kopieren zu .env und mit eigenen Werten füllen:
#   cp .env.example .env

# ============================================================================
# LLM-Anbieter (provider-agnostisch über das GoAI-Framework)
# ============================================================================
# Gewünschten Anbieter UND den zugehörigen API-Key setzen.
# Ohne LLM_PROVIDER wird der Anbieter automatisch am vorhandenen API-Key
# erkannt (Mistral zuerst).
#
#   Anbieter    API-Key-Variable
#   mistral     MISTRAL_API_KEY                (Standard)
#   openai      OPENAI_API_KEY
#   anthropic   ANTHROPIC_API_KEY
#   google      GEMINI_API_KEY oder GOOGLE_GENERATIVE_AI_API_KEY
#
LLM_PROVIDER=mistral
MISTRAL_API_KEY=

# Beispiel für andere Anbieter (ein Kommentar entfernen und Key eintragen):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Modell des Anbieters. Ohne Angabe gilt das Standardmodell je Anbieter:
#   mistral: mistral-small-2603 | openai: gpt-4o
#   anthropic: claude-sonnet-4-5 | google: gemini-2.5-flash
# LLM_MODEL=mistral-small-2603

# ============================================================================
# Datenbank (optional)
# ============================================================================
# SQLite-Pfad, Standard: data/kitchenops.db (wird beim Start angelegt).
# Im Docker-Container setzt docker-compose.yml DB_PATH=/data/kitchenops.db.
# DB_PATH=data/kitchenops.db

# ============================================================================
# Logging (optional)
# ============================================================================
# Level:  debug | info | warn | error   (Standard: info)
# Format: text | json                   (Standard: text; json für Logs-Aggregation)
# LOG_LEVEL=info
# LOG_FORMAT=text
